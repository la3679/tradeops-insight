# Local demonstration values only. Do not reuse these values outside local development.
POSTGRES_DB=tradeops
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=tradeops-local-only
KEYCLOAK_ADMIN=tradeops-admin
KEYCLOAK_ADMIN_PASSWORD=tradeops-admin-local-only

# Container-to-container URLs used by the local stack.
TRADEOPS_DATABASE_URL=postgresql+psycopg://tradeops:tradeops-local-only@postgres:5432/tradeops
TRADEOPS_WORKER_BROKER_URL=redis://redis:6379/0
TRADEOPS_WORKER_RESULT_BACKEND_URL=redis://redis:6379/1
TRADEOPS_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
TRADEOPS_OIDC_ISSUER=http://keycloak:8080/realms/tradeops
