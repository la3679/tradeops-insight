# Local-only infrastructure defaults. Copy to .env and rotate values for shared environments.
POSTGRES_DB=tradeops
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=tradeops-local
POSTGRES_PORT=5432
REDIS_PORT=6379

# API configuration. Use a secret manager outside local development.
TRADEOPS_ENVIRONMENT=development
TRADEOPS_DATABASE_URL=postgresql+asyncpg://tradeops:tradeops-local@localhost:5432/tradeops
TRADEOPS_REDIS_URL=redis://localhost:6379/0

# Model mode is mock unless an optional adapter is explicitly configured later.
TRADEOPS_MODEL_PROVIDER=mock
# OPENAI_API_KEY=
# TRADEOPS_OPENAI_MODEL=
# TRADEOPS_OPENAI_EMBEDDING_MODEL=
